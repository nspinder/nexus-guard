{
  "manifest_version": 3,
  "name": "NexusGuard - Scam & Fraud Detector",
  "version": "1.0.0",
  "description": "Real-time protection against phishing, scams, and malicious links. Scan URLs before you click.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "images/icon.svg"
  },
  "icons": {
    "128": "images/icon.svg"
  },
  "web_accessible_resources": [
    {
      "resources": ["images/icon.svg"],
      "matches": ["<all_urls>"]
    }
  ]
}
