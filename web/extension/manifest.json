{
  "manifest_version": 3,
  "name": "NexusGuard - WhatsApp Scam Detection",
  "version": "1.0.0",
  "description": "Real-time scam detection for WhatsApp messages",
  "permissions": [
    "scripting",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "http://localhost:3001/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "NexusGuard WhatsApp Monitor"
  }
}
