// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String   @id @default(cuid())
  clerkId               String   @unique
  email                 String   @unique
  subscriptionTier      String   @default("free") // free | pro | enterprise
  stripeCustomerId      String?  @unique
  stripeSubscriptionId  String?
  monthlyEmailLimit     Int      @default(100) // Updated based on tier
  monthlyEmailUsage     Int      @default(0) // Resets monthly
  emailUsageResetDate   DateTime? // When usage counter resets

  // OAuth integrations
  gmailRefreshToken     String?
  outlookRefreshToken   String?

  emailConsent          Boolean  @default(false)
  callConsent           Boolean  @default(false)
  dataRetentionDays     Int      @default(90)

  // Alert thresholds (as percentages 0-100)
  lowRiskThreshold      Int      @default(30)   // Below this = low risk (green)
  mediumRiskThreshold   Int      @default(60)  // Between low and medium = medium risk (orange)
  highRiskThreshold     Int      @default(80)  // Above medium = high risk (red)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  emails                Email[]
  callLogs              CallLog[]
  whatsappMessages      WhatsappMessage[]
  iMessages             IMessage[]
  alerts                Alert[]
  auditLogs             AuditLog[]
}

model Email {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  sender                String
  subject               String
  bodyPreview           String   @db.Text
  rawEmail              String?  @db.Text // encrypted, optional

  scamScore             Float?
  claudeReasoning       String?  @db.Text
  alertSent             Boolean  @default(false)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([userId])
}

model CallLog {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  callerId              String?
  phoneNumber           String
  callDurationSeconds   Int?

  scamScore             Float?
  claudeReasoning       String?  @db.Text
  alertSent             Boolean  @default(false)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([userId])
}

model WhatsappMessage {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  sender                String
  messageText           String   @db.Text

  scamScore             Float?
  claudeReasoning       String?  @db.Text
  alertSent             Boolean  @default(false)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([userId])
}

model IMessage {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  sender                String
  messageText           String   @db.Text
  iMessageId            String   @unique // Unique ID from macOS Messages app

  scamScore             Float?
  claudeReasoning       String?  @db.Text
  alertSent             Boolean  @default(false)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([userId])
}

model Alert {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type                  String   // email | call
  entityId              String   // email_id or call_log_id
  scamScore             Float

  alertSentAt           DateTime @default(now())
  userAcknowledged      Boolean  @default(false)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([userId])
}

model AuditLog {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  action                String
  resourceType          String

  createdAt             DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId])
}

model PhoneValidation {
  id                    String   @id @default(cuid())
  userId                String

  phoneNumber           String
  formatted             String
  country               String
  carrier               String?

  riskLevel             String   // low | medium | high
  threatLevel           String   // none | warning | danger
  isSpam                Boolean  @default(false)
  flags                 String[] @default([])
  warnings              String[] @default([])

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([userId])
}

model PasswordCheck {
  id                    String   @id @default(cuid())
  userId                String

  isBreach              Boolean  @default(false)
  breachCount           Int      @default(0)
  isCommon              Boolean  @default(false)
  strength              String   // weak | fair | good | strong
  riskLevel             String   // low | medium | high
  threatLevel           String   // none | warning | danger

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([userId])
}

model CommunityReport {
  id                    String   @id @default(cuid())
  userId                String

  type                  String   // url | phone | email
  target                String   // the URL, phone number, or email being reported
  threatType            String   // phishing | malware | spam | scam | other
  description           String   @db.Text
  evidence              String?  @db.Text

  upvotes               Int      @default(0)
  downvotes             Int      @default(0)
  status                String   @default("pending") // pending | verified | disputed | false_positive

  votes                 CommunityVote[]

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([type, target])
  @@index([status])
  @@index([userId, createdAt])
  @@unique([userId, target, type])
}

model CommunityVote {
  id                    String   @id @default(cuid())
  userId                String
  reportId              String
  report                CommunityReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  voteType              String   // upvote | downvote

  createdAt             DateTime @default(now())

  @@unique([userId, reportId])
  @@index([reportId])
}

model VoiceCallAnalysis {
  id                    String   @id @default(cuid())
  userId                String

  transcription         String   @db.Text
  duration              Int?     // seconds
  callerId              String?
  callType              String?  // whatsapp | facetime | phone

  scamIndicators        String[] @default([])
  deepfakeRisk          Float    @default(0) // 0-100 score
  overallRiskScore      Float    @default(0) // 0-100 score
  threatLevel           String   // none | warning | danger

  suspiciousFactors     String[] @default([])
  voicePatterns         Json?    // Stores voice pattern analysis details
  claudeAnalysis        String?  @db.Text

  recommendation        String?  @db.Text
  alertSent             Boolean  @default(false)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([userId])
  @@index([threatLevel])
}
